[Unit]
Description=TRATT Speech Annotation Tool (Production)
After=network-online.target tratt-net-network.service
Requires=tratt-net-network.service

[Container]
ContainerName=tratt
Image=localhost/visp-tratt:latest
Network=tratt-net.network
Volume=@@PROJECT_DIR@@/mounts/tratt/appconfig.json:/usr/local/apache2/htdocs/config/appconfig.json:ro,Z
Volume=@@PROJECT_DIR@@/mounts/tratt/httpd.conf:/usr/local/apache2/conf/httpd.conf:ro,Z
Volume=/etc/timezone:/etc/timezone:ro
Volume=/etc/localtime:/etc/localtime:ro

# Security hardening
DropCapability=ALL
AddCapability=SETGID SETUID NET_BIND_SERVICE
NoNewPrivileges=true
ReadOnly=true

# Resource limits
PodmanArgs=--memory=256m --cpus=0.25 --pids-limit=150 --tmpfs /tmp --tmpfs /run --tmpfs /usr/local/apache2/logs

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
