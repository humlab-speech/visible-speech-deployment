# VISP offline placeholder page — installed only by './visp.py placeholder up'.
# Not in the service registry: 'install', 'up all' etc. never pick it up, and
# starting apache (any visp.py path) removes it.
# Dev also serves HTTPS on 8443, like apache does with vhosts-https/.

[Unit]
Description=VISP offline placeholder page (stands in for apache)
Conflicts=apache.service

[Container]
Image=docker.io/library/nginx:1.30.0-alpine3.23
ContainerName=visp-placeholder
PublishPort=@@HTTP_PORT@@:80
PublishPort=8443:443
Volume=@@PROJECT_DIR@@/mounts/placeholder/html:/usr/share/nginx/html:ro,Z
Volume=@@PROJECT_DIR@@/mounts/placeholder/nginx/http.conf:/etc/nginx/conf.d/default.conf:ro,Z
Volume=@@PROJECT_DIR@@/mounts/placeholder/nginx/https.conf:/etc/nginx/conf.d/https.conf:ro,Z
Volume=@@PROJECT_DIR@@/certs/@@BASE_DOMAIN@@:/etc/certs:ro,z
ReadOnly=true
Tmpfs=/var/cache/nginx
NoNewPrivileges=true

[Service]
Restart=always

[Install]
WantedBy=default.target
