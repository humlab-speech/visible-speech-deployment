[Unit]
Description=Session Manager Service
After=network-online.target visp-net.service mongo.service podman-socket-proxy.service
Requires=mongo.service podman-socket-proxy.service

[Container]
ContainerName=session-manager
Image=localhost/visp-session-manager:latest
Network=visp-net.network
# Port 8020 not published - accessed via Apache proxy on internal network
EnvironmentFile=@@PROJECT_DIR@@/.env
Environment=LOG_LEVEL=debug
Environment=DEVELOPMENT_MODE=true
Environment=SESSION_MANAGER_KEEP_CONTAINERS=true
Environment=VISP_NETWORK_NAME=systemd-visp-net
Environment=WHISPERX_SOCKET_PATH=/run/whisperx/whisperx.sock
Environment=DOCKER_SOCKET_PATH=/run/podman-proxy/podman.sock
Secret=visp_api_access_token,type=env,target=HS_API_ACCESS_TOKEN
Secret=visp_mongo_root_password,type=env,target=MONGO_ROOT_PASSWORD
Volume=@@PROJECT_DIR@@/mounts/apache/apache/uploads:/tmp/uploads:Z
Volume=@@PROJECT_DIR@@/mounts/session-manager/logs:/session-manager/logs:Z
Volume=@@PROJECT_DIR@@/mounts/session-manager/unimported_audio:/unimported_audio:Z
# Proxy socket replaces the direct Podman socket. Mount the directory instead
# of the socket file so session-manager can start before the proxy creates the socket inode.
Volume=@@PROJECT_DIR@@/mounts/podman-proxy:/run/podman-proxy:Z
Volume=@@PROJECT_DIR@@/mounts/repositories:/repositories:Z
Volume=@@PROJECT_DIR@@/mounts/repository-template:/repository-template:Z
Volume=@@PROJECT_DIR@@/mounts/transcription-queued:/transcription-queued:Z
Volume=@@PROJECT_DIR@@/mounts/whisper/api:/run/whisperx:ro,z
Volume=@@PROJECT_DIR@@/mounts/sessions:/sessions:Z
# DEV MODE: Mount the source tree so edits are live — no image rebuild needed.
# The whole directory (not src/ alone) so package.json and node_modules are live too;
# individual file mounts would go stale, since a bind-mounted file pins the inode and
# editors/npm save by atomic rename. Mounted rw so 'visp.py npm' can install packages.
# Lowercase z (shared SELinux label), never Z — Z would relabel the source tree private
# to this container and lock the host editor out on SELinux systems.
Volume=@@PROJECT_DIR@@/external/session-manager:/session-manager:rw,z

# Security hardening
DropCapability=ALL
AddCapability=NET_BIND_SERVICE DAC_OVERRIDE CHOWN
NoNewPrivileges=true
# nodemon becomes PID 1 and does not reap orphans; session-manager shells out to
# git/ffmpeg/R, and a reload reparents those to PID 1. catatonit reaps them so
# frequent reloads don't leak zombies against --pids-limit.
RunInit=true

# Resource limits + DNS
PodmanArgs=--dns=10.89.1.1 --dns=10.89.0.1 --memory=2g --cpus=1.0 --pids-limit=200

# DEV MODE: hot reload. Overrides the image CMD (node src/index.js).
# nodemon ships in the image already — 'npm ci' in the Dockerfile installs devDependencies.
# Every setting is explicit rather than inherited from the mounted nodemon.json, so this
# unit keeps working if that file changes in the session-manager repo.
#   --signal SIGTERM  nodemon defaults to SIGUSR2, which src/index.js does not handle;
#                     SIGTERM runs the same graceful shutdown path as 'podman stop'
#   --delay 2         debounce, so a half-typed save doesn't restart mid-edit
#   --watch src       package.json/node_modules changes need 'visp.py restart', not a
#                     reload — restarting would not re-run npm install anyway
#   --exec            must be used instead of a trailing script argument: the mounted
#                     nodemon.json also sets "exec", and nodemon appends the script arg to
#                     it, producing 'node src/index.js src/index.js'
Exec=/session-manager/node_modules/.bin/nodemon --signal SIGTERM --delay 2 --watch src --ext js,json --exec "node src/index.js"

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
