[Unit]
Description=EMU-webapp Server
After=network-online.target visp-net.service mongo.service
Requires=mongo.service

[Container]
ContainerName=emu-webapp-server
Image=localhost/visp-emu-webapp-server:latest
Network=visp-net.network
PublishPort=127.0.0.1:17890:17890
EnvironmentFile=@@PROJECT_DIR@@/mounts/emu-webapp-server/.env
Environment=LOG_LEVEL=DEBUG
Secret=visp_mongo_uri,type=env,target=MONGO_URI
Secret=visp_media_file_base_url,type=env,target=MEDIA_FILE_BASE_URL
Secret=visp_media_file_base_url,type=env,target=MEDIA_FILE_BASE_URL
Volume=@@PROJECT_DIR@@/mounts/repositories:/repositories:Z
Volume=@@PROJECT_DIR@@/external/emu-webapp-server/src:/home/node/app/src:Z
Volume=@@PROJECT_DIR@@/external/emu-webapp-server/package.json:/home/node/app/package.json:ro,Z
Volume=@@PROJECT_DIR@@/external/emu-webapp-server/package-lock.json:/home/node/app/package-lock.json:ro,Z
Volume=/etc/timezone:/etc/timezone:ro
Volume=/etc/localtime:/etc/localtime:ro

# Pin this container's real service identity (node = uid 1000 / gid 1000 in the
# node base image) to the host repository owner via rootless keep-id. Writes into
# mounts/repositories then land owned by that single host identity — the same one
# session-manager, wsrng-server and apache all converge on — so every service can
# read and rewrite the others' files even with all capabilities dropped. As a
# bonus, container UID 0 maps to a harmless subuid (a root escape ≠ the host repo
# owner). Keep the explicit User= matching the keep-id values; don't rely on the
# image USER.
User=1000:1000
UserNS=keep-id:uid=1000,gid=1000

# Security hardening
DropCapability=ALL
NoNewPrivileges=true

# Resource limits
PodmanArgs=--memory=256m --cpus=0.5 --pids-limit=100

[Service]
Restart=unless-stopped
TimeoutStartSec=300

[Install]
WantedBy=default.target
