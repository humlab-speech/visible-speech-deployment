# =============================================================================
# Default (catch-all) vhost - Host allowlist enforcement  [DEV / ports 80+443]
# =============================================================================
# Apache uses the FIRST vhost defined for a given address:port as the fallback
# for any request whose Host header matches no other vhost. Today that slot is
# held by vhost.conf, which means an unrecognised hostname is served the
# application. This file exists to take that slot and reject those requests.
#
# Dev terminates TLS in Apache itself, so both :80 and :443 need a default.
# See the vhosts-http twin for the production configuration.
#
# ---------------------------------------------------------------------------
# SHIPPED DISABLED. To activate:
#     mv 000-default-deny.vhost.conf.disabled 000-default-deny.vhost.conf
#     ./visp.py restart apache
#
# apache2.conf already includes this filename ahead of vhost.conf and uses
# IncludeOptional, which does not error when the file is absent - so the
# rename is the only step. To roll back, rename it back and restart.
# ---------------------------------------------------------------------------
#
# BEFORE ACTIVATING, read logs/apache2/unexpected-host.log - see the header of
# the vhosts-http twin for the full list of internal callers that must keep
# working (Host: apache is load-bearing for WebSocket authentication).
# =============================================================================

<VirtualHost *:80>
  ServerName invalid.localhost

  <Location "/">
    Require all denied
  </Location>

  ErrorLog ${APACHE_LOG_DIR}/rejected-host-error.log
  CustomLog ${APACHE_LOG_DIR}/rejected-host-access.log host_combined
</VirtualHost>

<VirtualHost *:443>
  ServerName invalid.localhost

  # Apache refuses to start an SSL vhost without a certificate, even one whose
  # only job is to deny. Reusing the existing pair is fine: no client that
  # reaches this vhost gets a response worth validating a certificate for.
  SSLEngine On
  SSLCertificateFile /etc/certs/${BASE_DOMAIN}/cert.crt
  SSLCertificateKeyFile /etc/certs/${BASE_DOMAIN}/cert.key

  <Location "/">
    Require all denied
  </Location>

  ErrorLog ${APACHE_LOG_DIR}/rejected-host-error.log
  CustomLog ${APACHE_LOG_DIR}/rejected-host-access.log host_combined
</VirtualHost>
